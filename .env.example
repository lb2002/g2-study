# Optional defaults for LOCAL DEVELOPMENT only. Copy to .env.local (git-ignored).
# Vite inlines VITE_* values into the bundle, so `npm run build` refuses to run
# while any *_KEY variable is set. On the phone, enter keys in Settings instead.

# VITE_TRANSCRIBE_BASE_URL=http://192.168.1.10:8000/v1
# VITE_TRANSCRIBE_MODEL=Systran/faster-whisper-small
# VITE_TRANSCRIBE_API_KEY=

# VITE_LLM_BASE_URL=http://localhost:11434/v1
# VITE_LLM_MODEL=llama3.1:8b
# VITE_LLM_API_KEY=
