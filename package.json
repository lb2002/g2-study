{
  "name": "g2-study",
  "version": "0.1.0",
  "private": true,
  "description": "Lecture-to-flashcards plugin for Even Realities G2 smart glasses, with commute-sized review sessions.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "node node_modules/@evenrealities/evenhub-simulator/bin/index.js http://localhost:5173",
    "qr": "evenhub qr --port 5173",
    "pack": "npm run build && evenhub pack app.json dist -o g2-study.ehpk",
    "sim:auto": "node node_modules/@evenrealities/evenhub-simulator/bin/index.js http://localhost:5173 --automation-port 9898"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "idb": "^8.0.4",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "@types/node": "^22.20.5",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20.17"
  }
}
